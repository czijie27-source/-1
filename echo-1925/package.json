    "cover": "node scripts/render.mjs --cover-only",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/bundler": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
